  <!-- Astro의 define:vars를 사용해 빌드 타임의 데이터를 브라우저 팝업용 JS로 통째로 넘겨줍니다. -->
  <script define:vars={{ globalProducts, globalBoards }}>
    let currentActivePanelId = 'prod-all';

    function goToHome() {
      const prodGnbBtn = document.querySelector('.gnb-menu .gnb-btn');
      if (prodGnbBtn) switchLayer1('prod', prodGnbBtn);
      const allProdSubBtn = document.querySelector('#sub-prod .sub-btn');
      if (allProdSubBtn) switchLayer3('prod-all', allProdSubBtn);
      document.getElementById('searchInput').value = ''; 
      filterProducts();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function switchLayer1(groupKey, btnEl) {
      document.querySelectorAll('.gnb-btn').forEach(b => b.classList.remove('active'));
      btnEl.classList.add('active');
      document.querySelectorAll('.sub-menu-group').forEach(g => g.classList.remove('active'));
      const targetSubGroup = document.getElementById('sub-' + groupKey);
      const searchBox = document.getElementById('searchContainer');
      if (targetSubGroup) {
        targetSubGroup.classList.add('active');
        const firstSubBtn = targetSubGroup.querySelector('.sub-btn');
        if (firstSubBtn) firstSubBtn.click();
      }
      searchBox.style.display = groupKey === 'prod' ? 'flex' : 'none';
    }

    function switchLayer3(contentId, btnEl) {
      btnEl.parentElement.querySelectorAll('.sub-btn').forEach(b => b.classList.remove('active'));
      btnEl.classList.add('active');
      document.querySelectorAll('.content-panel').forEach(p => p.classList.remove('active'));
      const targetPanel = document.getElementById(contentId);
      if (targetPanel) {
        targetPanel.classList.add('active');
        currentActivePanelId = contentId;
        const sub2Box = targetPanel.querySelector('.sub2-menu-box');
        if (sub2Box) {
          const firstSub2Btn = sub2Box.querySelector('.sub2-btn');
          if (firstSub2Btn) firstSub2Btn.click();
        }
      }
    }

    function filterSub2(gridId, category2Keyword, btnEl) {
      btnEl.parentElement.querySelectorAll('.sub2-btn').forEach(b => b.classList.remove('active'));
      btnEl.classList.add('active');
      const cards = document.querySelectorAll(`#${gridId} .card`);
      const key = category2Keyword.toLowerCase().trim();
      cards.forEach(card => {
        const cat2 = (card.getAttribute('data-cat2') || '').toLowerCase();
        card.style.display = (key === 'all' || cat2.includes(key)) ? 'flex' : 'none';
      });
    }

    function filterProducts() {
      const type = document.getElementById('searchType').value;
      const query = document.getElementById('searchInput').value.toLowerCase().trim();
      if (query !== '') {
        const allBtn = document.querySelector("#sub-prod .sub-btn");
        if (allBtn && !allBtn.classList.contains('active')) switchLayer3('prod-all', allBtn);
      }
      document.querySelectorAll('#grid-전체 .card').forEach(card => {
        let textToSearch = type === 'title' ? card.getAttribute('data-title') : (type === 'maker' ? card.getAttribute('data-maker') : card.getAttribute('data-all'));
        card.style.display = (textToSearch || '').includes(query) ? 'flex' : 'none';
      });
    }

    function submitQuoteToEmail(event) {
      event.preventDefault();
      const btn = document.getElementById('quoteSubmitBtn');
      btn.innerText = '전송 중...'; btn.disabled = true;
      const formData = new URLSearchParams();
      formData.append('name', document.getElementById('wName').value);
      formData.append('company', document.getElementById('wCompany').value);
      formData.append('phone', document.getElementById('wPhone').value);
      formData.append('email', document.getElementById('wEmail').value);
      formData.append('model', document.getElementById('wModel').value);
      formData.append('usage', document.getElementById('wUsage').value);
      formData.append('fluid', document.getElementById('wFluid').value);
      formData.append('exp', document.getElementById('wExp').value);
      formData.append('qty', document.getElementById('wQty').value);
      formData.append('content', document.getElementById('wContent').value);
      
      const scriptURL = 'https://script.google.com/macros/s/AKfycbyIgq6G0vCCYu6reZMDV90yBmopMUqo9krv47HLSRX4I3pHIUKKoV4lL_203Zea7zxD/exec';
      fetch(scriptURL, { method: 'POST', body: formData })
        .then(() => { alert('견적 문의가 전달되었습니다.'); document.getElementById('quoteWebForm').reset(); })
        .catch(err => { alert('전송 오류. 전화 문의 부탁드립니다.'); console.error(err); })
        .finally(() => { btn.innerText = '견적문의 제출하기'; btn.disabled = false; });
    }

    Object.assign(window, {
      goToHome,
      switchLayer1,
      switchLayer3,
      filterSub2,
      filterProducts,
      submitQuoteToEmail
    });
  </script>
</body>
</html>
  .kakaomap-wrapper { width: 100%; position: relative; margin-bottom: 20px; }
  .kakaomap-inner { width: 100%; height: auto; border: 1px solid #ccc; max-width: 1278px; margin: 0 auto; }
  .kakaomap-inner img { width: 100%; height: auto; max-height: 498px; object-fit: cover; }
  .kakaomap-bottom { overflow: hidden; padding: 7px 11px; border: 1px solid rgba(0,0,0,0.1); border-top: none; border-radius: 0 0 2px 2px; background-color: #f9f9f9; max-width: 1278px; margin: 0 auto; }
</style>
</head>
<body>

  <!-- LAYER 1 -->
  <div class="layer-1">
    <div class="main-banner" onclick="goToHome()" title="홈으로 이동">
      <h1 id="bannerTitle">(주)엠밸리테크</h1>
      <p id="bannerSubtitle">세계일류를 꿈꾸는, 능동적이고 적극적인 개척정신</p>
    </div>
	<div class="gnb-menu">
	  <button class="gnb-btn active" onclick="location.href='/category/all'">제품소개</button>
	  <button class="gnb-btn" onclick="location.href='/board/category/all'">기술자료</button>
	  <button class="gnb-btn" onclick="location.href='/quote'">견적문의</button>
	  <button class="gnb-btn" onclick="location.href='/cs'">고객센터</button>
	  <button class="gnb-btn" onclick="location.href='/about'">회사소개</button>
	</div>
  </div>

  <!-- LAYER 2 -->
  <div class="layer-2">
	<div id="sub-prod" class="sub-menu-group active">
      <a href="/category/all" class="sub-btn active">전체</a>
      <a href="/category/dew" class="sub-btn">노점계</a>
      <a href="/category/aw" class="sub-btn">수분활성도측정기</a>
      <a href="/category/moist" class="sub-btn">수분측정기</a>
      <a href="/category/flow" class="sub-btn">유량계</a>
      <a href="/category/gasana" class="sub-btn">가스분석기</a>
      <a href="/category/gasdet" class="sub-btn">가스측정기</a>
      <a href="/category/temp" class="sub-btn">정밀 온습도계</a>
    </div>
	<div id="sub-tech" class="sub-menu-group">
      <a href="/board/category/all" class="sub-btn">전체</a>
      <a href="/board/category/general" class="sub-btn">범용 기술자료</a>
      <a href="/board/category/video" class="sub-btn">동영상 자료</a>
    </div>
    <div id="sub-quote" class="sub-menu-group">
      <button class="sub-btn active" onclick="switchLayer3('quote-form', this)">견적문의 작성</button>
    </div>
    <div id="sub-cs" class="sub-menu-group">
      <button class="sub-btn active" onclick="switchLayer3('cs-notice', this)">공지사항</button>
    </div>
    <div id="sub-about" class="sub-menu-group">
      <button class="sub-btn active" onclick="switchLayer3('about-combined', this)">회사소개</button>
    </div>
  </div>

  <!-- LAYER 3 -->
  <div class="layer-3">
    <!-- 검색창 -->
    <div class="search-container" id="searchContainer">
      <div class="search-box">
        <select id="searchType" class="search-select" onchange="filterProducts()">
          <option value="all">통합검색</option>
          <option value="title">상품명</option>
          <option value="maker">제조사</option>
        </select>
        <input type="text" id="searchInput" class="search-input" placeholder="검색어를 입력하세요..." oninput="filterProducts()">
      </div>
    </div>

    <!-- 1차 카테고리 패널 구역 (서버에서 가져온 데이터를 set:html로 미리 박아넣음) -->
    <div id="prod-all" class="content-panel active"><div class="card-grid" id="grid-전체" set:html={htmlGridAll}></div></div>
    
    <div id="prod-dew" class="content-panel">
      <div class="sub2-menu-box" id="sub2-노점계">
        <button class="sub2-btn active" onclick="filterSub2('grid-노점계', 'all', this)">All</button><span class="sub2-divider">|</span>

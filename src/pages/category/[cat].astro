---
export async function getStaticPaths() {
  return [
    { params: { cat: 'all' }, props: { targetId: 'prod-all' } },
    { params: { cat: 'dew' }, props: { targetId: 'prod-dew' } },
    { params: { cat: 'aw' }, props: { targetId: 'prod-aw' } },
    { params: { cat: 'moist' }, props: { targetId: 'prod-moist' } },
    { params: { cat: 'flow' }, props: { targetId: 'prod-flow' } },
    { params: { cat: 'gasana' }, props: { targetId: 'prod-gasana' } },
    { params: { cat: 'gasdet' }, props: { targetId: 'prod-gasdet' } },
    { params: { cat: 'temp' }, props: { targetId: 'prod-temp' } },
  ];
}

const { cat } = Astro.params;
const { targetId } = Astro.props;

const SHEET_ID = '12QBZHTDjAZg35NkGHappq2AiwdGf40RdxVb7zxXRwuE';

const prodUrl = `https://docs.google.com/spreadsheets/d/${SHEET_ID}/gviz/tq?tqx=out:json&headers=1&sheet=제품목록`;
const prodRes = await fetch(prodUrl);
const prodText = await prodRes.text();
const prodJson = JSON.parse(prodText.substring(47, prodText.length - 2));
let rows = (prodJson.table.rows || []).filter(r => r.c && r.c[0]?.v && r.c[0].v !== '1차카테고리');
rows.sort((a, b) => (parseInt(a.c[2]?.v) || 9999) - (parseInt(b.c[2]?.v) || 9999));

const globalProducts = [];
let htmlGridAll = '', htmlGridDew = '', htmlGridAw = '', htmlGridMoist = '', htmlGridFlow = '', htmlGridGasana = '', htmlGridGasdet = '', htmlGridTemp = '';

function getSlug(text) {
  const map = {
    '노점계': 'dew', '수분활성도측정기': 'aw', '수분측정기': 'moist',
    '유량계': 'flow', '가스분석기': 'gasana', '가스측정기': 'gasdet', '온습도계': 'temp',
    '휴대용': 'portable', '설치형': 'fixed', '부식가스용': 'corrosive', '판넬': 'panel',
    '탁상형': 'tabletop', '습도시약': 'reagent', '콘크리트': 'concrete', '목재': 'wood', '오일': 'oil',
    '초음파': 'ultrasonic', '인라인': 'inline', '산소': 'oxygen', '수분': 'moisture',
    '일산화탄소': 'co', '이산화탄소': 'co2', '메탄': 'ch4', '암모니아': 'nh3',
    '특수가스': 'special', '다종가스': 'multi', '장비': 'equipment',
    '벽걸이형': 'wall', '프로브': 'probe', '데이터로거': 'logger'
  };
  return map[text] || encodeURIComponent(text);
}

rows.forEach((r, index) => {
  const c = r.c;
  if (!c || !c[0] || !c[3]) return;
  const p = {
    category1: c[0]?.v || '', category2: c[1]?.v || '', title: c[3]?.v || '',
    usage: c[4]?.v || '-', feature: c[5]?.v || '-', maker: c[6]?.v || '-',
    range: c[7]?.v || '', imgUrl: c[8]?.v || 'https://via.placeholder.com/340x200?text=No+Image',
    desc: c[9]?.v || '',
    pdfs: [ { name: c[10]?.v || '', url: c[11]?.v || '' }, { name: c[12]?.v || '', url: c[13]?.v || '' }, { name: c[14]?.v || '', url: c[15]?.v || '' }, { name: c[16]?.v || '', url: c[17]?.v || '' } ]
  };
  globalProducts.push(p);

  const searchAllStr = (p.title + ' ' + p.usage + ' ' + p.maker).toLowerCase();
  const c1 = getSlug(p.category1 || 'all');
  const c2 = getSlug(p.category2 || 'all');

  const cardHTML = `
    <div class="card" onclick="location.href='/product/${c1}/${c2}/${index}'" data-cat2="${p.category2.toLowerCase()}" data-title="${p.title.toLowerCase()}" data-maker="${p.maker.toLowerCase()}" data-all="${searchAllStr}">
      <img src="${p.imgUrl}" class="card-img" alt="${p.title}" onerror="this.src='https://via.placeholder.com/340x200?text=No+Image'">
      <div class="card-body">
        <div class="card-title">${p.title}</div>
        <div class="card-info"><span>용도</span>: ${p.usage}</div>
        <div class="card-info"><span>특성</span>: ${p.feature}</div>
        ${p.range ? `<div class="card-info"><span>측정</span>: ${p.range}</div>` : ''}
        <div class="card-info"><span>제조</span>: ${p.maker}</div>
      </div>
    </div>`;
  
  htmlGridAll += cardHTML;
  if (p.category1 === '노점계') htmlGridDew += cardHTML;
  else if (p.category1 === '수분활성도측정기') htmlGridAw += cardHTML;
  else if (p.category1 === '수분측정기') htmlGridMoist += cardHTML;
  else if (p.category1 === '유량계') htmlGridFlow += cardHTML;
  else if (p.category1 === '가스분석기') htmlGridGasana += cardHTML;
  else if (p.category1 === '가스측정기') htmlGridGasdet += cardHTML;
  else if (p.category1 === '온습도계') htmlGridTemp += cardHTML;
});

const boardUrl = `https://docs.google.com/spreadsheets/d/${SHEET_ID}/gviz/tq?tqx=out:json&headers=1&sheet=기술자료`;
const boardRes = await fetch(boardUrl);
const boardText = await boardRes.text();
const boardJson = JSON.parse(boardText.substring(47, boardText.length - 2));
let bRows = (boardJson.table.rows || []).filter(r => r.c && r.c[0]?.v && r.c[0].v !== '분류');

const globalBoards = [];
let htmlBoardAll = '', htmlBoardGeneral = '', htmlBoardVideo = '', htmlBoardNotice = '';

bRows.forEach((r, originalIndex) => {
  const c = r.c;
  if (!c || !c[0]) return;
  const b = {
    _originalIndex: originalIndex, category: c[0]?.v || '', title: c[1]?.v || c[1]?.f || '제목 없음',
    date: c[2]?.f || c[2]?.v || '날짜 없음', content: String(c[5]?.v || ''), imgUrl: c[3]?.v || '',
    youtubeId: c[4]?.v || '', fileName: c[6]?.v || '', fileUrl: c[7]?.v || ''
  };
  globalBoards.push(b);
});

[...globalBoards].reverse().forEach((post) => {
  let displayTitle = post.title;
  if (post.fileUrl && post.fileUrl.startsWith('http')) displayTitle = post.title + ' 💾';
  const trHTML = `<tr><td>${post.category}</td><td class="b-title" onclick="location.href='/board/${post._originalIndex}'">${displayTitle}</td><td>${post.date}</td></tr>`;
  if (post.category === '범용' || post.category === '동영상') htmlBoardAll += trHTML;
  if (post.category === '범용') htmlBoardGeneral += trHTML;
  else if (post.category === '동영상') htmlBoardVideo += trHTML;
  else if (post.category === '공지사항') htmlBoardNotice += trHTML;
});

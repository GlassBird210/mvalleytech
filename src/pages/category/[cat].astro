        <button class="sub2-btn" onclick="filterSub2('grid-노점계', '부식가스용', this)">부식가스용</button><span class="sub2-divider">|</span>
        <button class="sub2-btn" onclick="filterSub2('grid-노점계', '판넬', this)">판넬</button>
      </div>
      <div class="card-grid" id="grid-노점계" set:html={htmlGridDew}></div>
    </div>

    <div id="prod-aw" class={`content-panel ${targetId === 'prod-aw' ? 'active' : ''}`}>

        <button class="sub2-btn active" onclick="filterSub2('grid-수분활성도측정기', 'all', this)">All</button><span class="sub2-divider">|</span>
        <button class="sub2-btn" onclick="filterSub2('grid-수분활성도측정기', '휴대용', this)">휴대용</button><span class="sub2-divider">|</span>
        <button class="sub2-btn" onclick="filterSub2('grid-수분활성도측정기', '탁상형', this)">탁상형</button><span class="sub2-divider">|</span>
        <button class="sub2-btn" onclick="filterSub2('grid-수분활성도측정기', '습도시약', this)">습도시약 / 샘플케이스</button>
      </div>
      <div class="card-grid" id="grid-수분활성도측정기" set:html={htmlGridAw}></div>
    </div>

    <div id="prod-moist" class={`content-panel ${targetId === 'prod-moist' ? 'active' : ''}`}>
      <div class="sub2-menu-box" id="sub2-수분측정기">
        <button class="sub2-btn active" onclick="filterSub2('grid-수분측정기', 'all', this)">All</button><span class="sub2-divider">|</span>
        <button class="sub2-btn" onclick="filterSub2('grid-수분측정기', '콘크리트', this)">콘크리트</button><span class="sub2-divider">|</span>
        <button class="sub2-btn" onclick="filterSub2('grid-수분측정기', '목재', this)">목재</button><span class="sub2-divider">|</span>
        <button class="sub2-btn" onclick="filterSub2('grid-수분측정기', '오일', this)">오일</button>
      </div>
      <div class="card-grid" id="grid-수분측정기" set:html={htmlGridMoist}></div>
    </div>

    <div id="prod-flow" class={`content-panel ${targetId === 'prod-flow' ? 'active' : ''}`}>
      <div class="sub2-menu-box" id="sub2-유량계">
        <button class="sub2-btn active" onclick="filterSub2('grid-유량계', 'all', this)">All</button><span class="sub2-divider">|</span>
        <button class="sub2-btn" onclick="filterSub2('grid-유량계', '초음파', this)">초음파(외벽부착형)</button><span class="sub2-divider">|</span>
        <button class="sub2-btn" onclick="filterSub2('grid-유량계', '인라인', this)">인라인(면적식)</button>
      </div>
      <div class="card-grid" id="grid-유량계" set:html={htmlGridFlow}></div>
    </div>

    <div id="prod-gasana" class={`content-panel ${targetId === 'prod-gasana' ? 'active' : ''}`}>
      <div class="sub2-menu-box" id="sub2-가스분석기">
        <button class="sub2-btn active" onclick="filterSub2('grid-가스분석기', 'all', this)">All</button><span class="sub2-divider">|</span>
        <button class="sub2-btn" onclick="filterSub2('grid-가스분석기', '산소', this)">산소(O₂)</button><span class="sub2-divider">|</span>
        <button class="sub2-btn" onclick="filterSub2('grid-가스분석기', '수분', this)">수분(H₂O) / 중수(D₂O)</button><span class="sub2-divider">|</span>

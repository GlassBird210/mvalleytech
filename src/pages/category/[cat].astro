    <div id="prod-all" class={`content-panel ${targetId === 'prod-all' ? 'active' : ''}`}><div class="card-grid" id="grid-전체" set:html={htmlGridAll}></div></div>
    
    <div id="prod-dew" class={`content-panel ${targetId === 'prod-dew' ? 'active' : ''}`}>
      <div class="sub2-menu-box" id="sub2-노점계">
        <button class="sub2-btn active" onclick="filterSub2('grid-노점계', 'all', this)">All</button><span class="sub2-divider">|</span>
        <button class="sub2-btn" onclick="filterSub2('grid-노점계', '휴대용', this)">휴대용</button><span class="sub2-divider">|</span>
